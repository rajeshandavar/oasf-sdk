{
  "permissions": {
    "allow": [
      "Bash(task:*)",
      "Bash(go version:*)",
      "Bash(go build:*)",
      "Bash($PORT = Get-Random -Minimum 30000 -Maximum 40000)",
      "Bash($env:OASF_SDK_LISTEN_ADDRESS = \"0.0.0.0:$PORT\")",
      "Bash(Write-Host \"Starting OASF SDK server on port $PORT...\")",
      "Bash(Write-Host \"Server address: 0.0.0.0:$PORT\")",
      "Bash(.binoasf-sdk.exe)",
      "Bash(docker buildx bake:*)",
      "Bash(go mod tidy:*)",
      "Bash(CGO_ENABLED=0 go build:*)",
      "Bash(wsl --list:*)",
      "Bash(grpcurl:*)",
      "Bash(go install:*)",
      "Bash($env:PATH = \"$env:USERPROFILE\\\\go\\\\bin;$env:PATH\")",
      "Bash(~/go/bin/grpcurl:*)",
      "Bash(git log:*)",
      "Bash(go test:*)",
      "Bash(ls:*)",
      "Bash(for dir in pkg server e2e)",
      "Bash(do if [ -f \"$dir/go.mod\" ])",
      "Bash(then echo \"$dir\")",
      "Bash(fi)",
      "Bash(done)",
      "Bash(find:*)",
      "Bash(where find:*)",
      "Bash(docker --version:*)",
      "Bash(.\\\\\\\\bin\\\\\\\\oasf-sdk.exe:*)",
      "Bash(./bin/oasf-sdk.exe:*)",
      "Bash(timeout 3:*)"
    ]
  }
}
